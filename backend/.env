# Railway MySQL plugin injects these automatically when a MySQL service is connected:
# MYSQLHOST, MYSQLUSER, MYSQLPASSWORD, MYSQL_DATABASE
#
# For local development, set the DB_* equivalents below:
DB_HOST=your-mysql-host
DB_USER=your-user
DB_PASSWORD=your-password
DB_NAME=urban_harvest
PORT=5000
FRONTEND_URL=https://your-frontend.vercel.app
